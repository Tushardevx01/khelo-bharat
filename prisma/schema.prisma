generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  COACH
  ATHLETE
  SPONSOR
}

enum OrganizerType {
  ADMIN
  SCHOOL
  COACH
  SPONSOR
}

enum TournamentStatus {
  DRAFT
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum TournamentFormat {
  LEAGUE
  KNOCKOUT
  GROUP
  MIXED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RegistrationParticipantType {
  ATHLETE
  SCHOOL
  TEAM
}

enum CertificateType {
  PARTICIPATION
  ACHIEVEMENT
  MERIT
  COMPLETION
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ContactStatus {
  PENDING
  READ
  REPLIED
  ARCHIVED
}

enum SponsorshipStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SponsorshipType {
  ATHLETE
  SCHOOL
  TOURNAMENT
}

enum GalleryType {
  IMAGE
  VIDEO
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  phone         String?
  role          UserRole
  avatar        String?
  emailVerified DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  athleteProfile   AthleteProfile?
  schoolProfile    SchoolProfile?
  coachProfile     CoachProfile?
  sponsorProfile   SponsorProfile?
  notifications    Notification[]
  messagesSent     Message[]      @relation("MessageSender")
  messagesReceived Message[]      @relation("MessageReceiver")
  gallery          Gallery[]
  contactRequests  ContactRequest[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model AthleteProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  latitude         Float?
  longitude        Float?
  bio              String?
  sports           String?
  position         String?
  schoolId         String?
  coachId          String?
  achievementsCount Int     @default(0)
  certificatesCount Int     @default(0)
  ranking          Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements        Achievement[]
  performanceRecords  PerformanceRecord[]
  athleteSports       AthleteSport[]

  @@index([userId])
  @@index([ranking])
  @@index([city, state])
}

model SchoolProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  name         String
  type         String
  address      String
  city         String
  state        String
  pincode      String?
  latitude     Float?
  longitude    Float?
  website      String?
  phone        String?
  email        String?
  logo         String?
  description  String?
  establishedYear Int?
  totalStudents   Int  @default(0)
  totalSports     Int  @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([city, state])
}

model CoachProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  specialization  String?
  experience      Int?
  certifications  String?
  bio             String?
  address         String?
  city            String?
  state           String?
  latitude        Float?
  longitude       Float?
  hourlyRate      Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([city, state])
}

model SponsorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  industry    String?
  website     String?
  logo        String?
  description String?
  budget      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Sport {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String?
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tournaments      Tournament[]
  performanceRecords PerformanceRecord[]
  athleteSports     AthleteSport[]

  @@index([slug])
  @@index([isActive])
}

model Tournament {
  id                   String           @id @default(uuid())
  title                String
  slug                 String           @unique
  description          String?
  sportId              String
  organizerId          String
  organizerType        OrganizerType
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  location             String
  address              String?
  city                 String
  state                String
  latitude             Float?
  longitude            Float?
  format               TournamentFormat
  maxParticipants      Int
  entryFee             Float            @default(0)
  prizePool            Float            @default(0)
  status               TournamentStatus @default(DRAFT)
  imageUrl             String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  sport         Sport                 @relation(fields: [sportId], references: [id])
  registrations TournamentRegistration[]
  fixtures      TournamentFixture[]
  certificates  Certificate[]

  @@index([sportId])
  @@index([organizerId])
  @@index([status])
  @@index([startDate])
  @@index([city, state])
  @@index([createdAt])
}

model TournamentRegistration {
  id              String                    @id @default(uuid())
  tournamentId    String
  participantId   String
  participantType RegistrationParticipantType
  status          RegistrationStatus        @default(PENDING)
  registeredAt    DateTime                  @default(now())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, participantId])
  @@index([tournamentId])
  @@index([participantId])
  @@index([status])
}

model TournamentFixture {
  id             String        @id @default(uuid())
  tournamentId   String
  round          Int
  matchNumber    Int
  participant1Id String?
  participant2Id String?
  winnerId       String?
  score1         Int?
  score2         Int?
  scheduledAt    DateTime?
  venue          String?
  status         FixtureStatus @default(SCHEDULED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([round, matchNumber])
}

model Achievement {
  id          String   @id @default(uuid())
  athleteId   String
  title       String
  description String?
  date        DateTime
  category    String
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([category])
  @@index([date])
}

model Certificate {
  id          String         @id @default(uuid())
  title       String
  description String?
  type        CertificateType
  recipientId String
  issuerId    String
  tournamentId String?
  athleteId   String?
  qrCode      String?
  pdfUrl      String?
  issuedAt    DateTime       @default(now())
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tournament Tournament?    @relation(fields: [tournamentId], references: [id])
  recipient  User           @relation(fields: [recipientId], references: [id])
  issuer     User           @relation(fields: [issuerId], references: [id])

  @@index([recipientId])
  @@index([issuerId])
  @@index([tournamentId])
  @@index([type])
  @@index([issuedAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model PerformanceRecord {
  id        String   @id @default(uuid())
  athleteId String
  sportId   String
  date      DateTime
  metric    String
  value     Float
  unit      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sport   Sport          @relation(fields: [sportId], references: [id])

  @@index([athleteId])
  @@index([sportId])
  @@index([date])
}

model SponsorshipRequest {
  id           String            @id @default(uuid())
  sponsorId    String
  athleteId    String?
  schoolId     String?
  tournamentId String?
  type         SponsorshipType
  amount       Float
  message      String?
  status       SponsorshipStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([sponsorId])
  @@index([status])
  @@index([type])
}

model Gallery {
  id          String      @id @default(uuid())
  userId      String
  title       String
  description String?
  imageUrl    String
  type        GalleryType @default(IMAGE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("MessageSender", fields: [senderId], references: [id])
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model ContactRequest {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AthleteSport {
  id          String   @id @default(uuid())
  athleteId   String
  sportId     String
  level       String?
  achievements String?
  createdAt   DateTime @default(now())

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sport   Sport          @relation(fields: [sportId], references: [id])

  @@unique([athleteId, sportId])
  @@index([athleteId])
  @@index([sportId])
}
