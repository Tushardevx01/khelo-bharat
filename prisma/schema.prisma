generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  ATHLETE
  COACH
  SPONSOR
}

enum SportCategory {
  CRICKET
  FOOTBALL
  BASKETBALL
  TENNIS
  BADMINTON
  ATHLETICS
  SWIMMING
  VOLLEYBALL
  HOCKEY
  KABADDI
  OTHER
}

enum TournamentStatus {
  DRAFT
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum CertificateStatus {
  PENDING
  GENERATED
  DOWNLOADED
  REVOKED
}

enum SponsorStatus {
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum NotificationType {
  TOURNAMENT
  ACHIEVEMENT
  MESSAGE
  SPONSOR
  SYSTEM
  CERTIFICATE
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
  POSTPONED
}

// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  clerkId         String    @unique
  role            UserRole
  email           String    @unique
  name            String
  phone           String?
  avatar          String?
  bio             String?
  dateOfBirth     DateTime?
  gender          Gender?
  location        String?
  latitude        Float?
  longitude       Float?
  isVerified      Boolean   @default(false)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  athlete         Athlete?
  school          School?
  coach           Coach?
  sponsor         Sponsor?

  certificates    Certificate[]
  notifications   Notification[]
  sentMessages    Message[]       @relation("Sender")
  receivedMessages Message[]      @relation("Receiver")
  galleries       Gallery[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([clerkId])
  @@index([role])
  @@index([isActive, deletedAt])
}

model Athlete {
  id              String    @id @default(uuid())
  userId          String    @unique
  sportCategory   SportCategory
  schoolId        String?
  coachId         String?
  height          Float?
  weight          Float?
  experience      Int       @default(0)
  achievementsCount Int     @default(0)
  ranking         Int?
  isFeatured      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  school          School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  coach           Coach?    @relation(fields: [coachId], references: [id], onDelete: SetNull)

  performances    Performance[]
  achievements    Achievement[]
  sponsorships    Sponsorship[]
  registrations   TournamentRegistration[]

  @@index([userId])
  @@index([sportCategory])
  @@index([schoolId])
  @@index([coachId])
  @@index([ranking])
  @@index([isFeatured])
}

model School {
  id                  String    @id @default(uuid())
  userId              String    @unique
  schoolName          String
  schoolType          String?
  address             String?
  city                String?
  state               String?
  pincode             String?
  latitude            Float?
  longitude           Float?
  website             String?
  principalName       String?
  establishedYear     Int?
  totalStudents       Int       @default(0)
  sportsFacilities    String[]
  isVerified          Boolean   @default(false)
  rating              Float     @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  athletes            Athlete[]
  sponsorships        Sponsorship[]

  @@index([userId])
  @@index([city, state])
  @@index([isVerified])
}

model Coach {
  id              String    @id @default(uuid())
  userId          String    @unique
  sportCategory   SportCategory
  specialization  String?
  certifications  String[]
  experience      Int       @default(0)
  rating          Float     @default(0)
  hourlyRate      Float?
  isAvailable     Boolean   @default(true)
  athletesCount   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  athletes        Athlete[]

  @@index([userId])
  @@index([sportCategory])
  @@index([isAvailable])
}

model Sponsor {
  id                  String    @id @default(uuid())
  userId              String    @unique
  companyName         String
  companyType         String?
  industry            String?
  budget              Float?
  website             String?
  logo                String?
  isVerified          Boolean   @default(false)
  totalSponsored      Float     @default(0)
  activeSponsorships  Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsorships        Sponsorship[]

  @@index([userId])
  @@index([companyName])
  @@index([isVerified])
}

model Tournament {
  id                    String    @id @default(uuid())
  organizerId           String
  title                 String
  description           String?
  sportCategory         SportCategory
  status                TournamentStatus @default(DRAFT)
  startDate             DateTime
  endDate               DateTime
  registrationDeadline  DateTime?
  location              String?
  city                  String?
  state                 String?
  latitude              Float?
  longitude             Float?
  maxParticipants       Int?
  entryFee              Float     @default(0)
  prizePool             Float     @default(0)
  rules                 String?
  poster                String?
  isFeatured            Boolean   @default(false)
  totalParticipants     Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  registrations         TournamentRegistration[]
  matches               Match[]
  performances          Performance[]
  certificates          Certificate[]
  galleries             Gallery[]

  @@index([organizerId])
  @@index([sportCategory])
  @@index([status])
  @@index([startDate])
  @@index([isFeatured])
  @@index([city, state])
  @@index([deletedAt])
}

model TournamentRegistration {
  id              String    @id @default(uuid())
  tournamentId    String
  athleteId       String
  teamName        String?
  status          String    @default("PENDING")
  registeredAt    DateTime  @default(now())
  paymentStatus   String    @default("PENDING")
  paymentAmount   Float     @default(0)

  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  athlete         Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, athleteId])
  @@index([tournamentId])
  @@index([athleteId])
  @@index([status])
}

model Match {
  id              String    @id @default(uuid())
  tournamentId    String
  round           Int?
  matchNumber     Int?
  player1Id       String?
  player2Id       String?
  winnerId        String?
  score           String?
  status          MatchStatus @default(SCHEDULED)
  scheduledAt     DateTime?
  completedAt     DateTime?
  venue           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  performances    Performance[]

  @@index([tournamentId])
  @@index([player1Id])
  @@index([player2Id])
  @@index([winnerId])
  @@index([status])
  @@index([scheduledAt])
}

model Performance {
  id              String    @id @default(uuid())
  athleteId       String
  tournamentId    String?
  matchId         String?
  sport           SportCategory
  score           Float?
  rank            Int?
  stats           Json?
  notes           String?
  date            DateTime  @default(now())
  createdAt       DateTime  @default(now())

  athlete         Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  tournament      Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  match           Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([athleteId])
  @@index([tournamentId])
  @@index([matchId])
  @@index([sport])
  @@index([date])
}

model Certificate {
  id              String    @id @default(uuid())
  userId          String
  tournamentId    String?
  title           String
  description     String?
  certificateType String?
  status          CertificateStatus @default(PENDING)
  certificateUrl  String?
  issuedAt        DateTime?
  expiresAt       DateTime?
  verificationCode String  @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament      Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tournamentId])
  @@index([verificationCode])
  @@index([status])
}

model Achievement {
  id              String    @id @default(uuid())
  athleteId       String
  title           String
  description     String?
  sport           SportCategory
  date            DateTime?
  image           String?
  verifiedBy      String?
  isVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  athlete         Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([sport])
  @@index([isVerified])
  @@index([date])
}

model Sponsorship {
  id              String    @id @default(uuid())
  sponsorId       String
  athleteId       String?
  schoolId        String?
  tournamentId    String?
  amount          Float
  startDate       DateTime
  endDate         DateTime
  status          SponsorStatus @default(PENDING)
  terms           String?
  logo            String?
  metrics         Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sponsor         Sponsor   @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  athlete         Athlete?  @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  school          School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  tournament      Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([sponsorId])
  @@index([athleteId])
  @@index([schoolId])
  @@index([tournamentId])
  @@index([status])
  @@index([startDate, endDate])
}

model Message {
  id              String    @id @default(uuid())
  senderId        String
  receiverId      String
  content         String
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  sender          User      @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User      @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([isRead])
  @@index([deletedAt])
}

model Notification {
  id              String    @id @default(uuid())
  userId          String
  type            NotificationType
  title           String
  message         String
  data            Json?
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model Gallery {
  id              String    @id @default(uuid())
  userId          String
  tournamentId    String?
  title           String?
  description     String?
  mediaUrl        String
  mediaType       String    @default("IMAGE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament      Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tournamentId])
  @@index([mediaType])
  @@index([createdAt])
}

model AuditLog {
  id              String    @id @default(uuid())
  userId          String?
  action          String
  entity          String
  entityId        String?
  oldData         Json?
  newData         Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}
