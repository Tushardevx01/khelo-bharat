generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  COACH
  ATHLETE
  SPONSOR
}

enum OrganizerType {
  SCHOOL
  COACH
  SPONSOR
  ADMIN
}

enum TournamentFormat {
  LEAGUE
  KNOCKOUT
  GROUP
  MIXED
}

enum TournamentStatus {
  DRAFT
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationParticipantType {
  ATHLETE
  SCHOOL
  TEAM
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum CertificateType {
  PARTICIPATION
  ACHIEVEMENT
  MERIT
  COMPLETION
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum GalleryType {
  IMAGE
  VIDEO
}

enum SponsorshipType {
  ATHLETE
  SCHOOL
  TOURNAMENT
}

enum SponsorshipStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ContactRequestStatus {
  PENDING
  READ
  REPLIED
  ARCHIVED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  role          UserRole
  avatar        String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  athleteProfile       AthleteProfile?
  schoolProfile        SchoolProfile?
  coachProfile         CoachProfile?
  sponsorProfile       SponsorProfile?
  notifications        Notification[]
  galleries            Gallery[]
  sentMessages         Message[]       @relation("Sender")
  receivedMessages     Message[]       @relation("Receiver")
  organizerTournaments Tournament[]    @relation("Organizer")

  @@index([email])
  @@index([role])
}

model AthleteProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  latitude          Float?
  longitude         Float?
  bio               String?
  sports            String?
  position          String?
  schoolId          String?
  coachId           String?
  achievementsCount Int       @default(0)
  certificatesCount Int       @default(0)
  ranking           Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  school              SchoolProfile?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  coach               CoachProfile?        @relation(fields: [coachId], references: [id], onDelete: SetNull)
  athleteSports       AthleteSport[]
  achievements        Achievement[]
  performanceRecords  PerformanceRecord[]
  certificates        Certificate[]        @relation("AthleteCertificates")
  sponsorshipRequests SponsorshipRequest[] @relation("AthleteSponsorships")

  @@index([userId])
  @@index([schoolId])
  @@index([coachId])
  @@index([city, state])
}

model SchoolProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  name            String
  type            String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  latitude        Float?
  longitude       Float?
  website         String?
  phone           String?
  email           String?
  logo            String?
  description     String?
  establishedYear Int?
  totalStudents   Int?
  totalSports     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  athletes            AthleteProfile[]
  sponsorshipRequests SponsorshipRequest[] @relation("SchoolSponsorships")

  @@index([userId])
  @@index([city, state])
}

model CoachProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  specialization String?
  experience     Int?
  certifications String?
  bio            String?
  latitude       Float?
  longitude      Float?
  address        String?
  city           String?
  state          String?
  hourlyRate     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  athletes AthleteProfile[]

  @@index([userId])
  @@index([city, state])
}

model SponsorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  industry    String?
  website     String?
  logo        String?
  description String?
  budget      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsorshipRequests SponsorshipRequest[] @relation("SponsorSponsorships")

  @@index([userId])
}

model Sport {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  icon        String?
  description String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tournaments        Tournament[]
  performanceRecords PerformanceRecord[]
  athleteSports      AthleteSport[]

  @@index([slug])
  @@index([category])
  @@index([isActive])
}

model Tournament {
  id                   String           @id @default(uuid())
  title                String
  slug                 String           @unique
  description          String?
  sportId              String
  organizerId          String
  organizerType        OrganizerType
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  location             String?
  address              String?
  city                 String?
  state                String?
  latitude             Float?
  longitude            Float?
  format               TournamentFormat
  maxParticipants      Int?
  entryFee             Float?
  prizePool            Float?
  status               TournamentStatus @default(DRAFT)
  imageUrl             String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  sport               Sport                    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  organizer           User                     @relation("Organizer", fields: [organizerId], references: [id], onDelete: Cascade)
  registrations       TournamentRegistration[]
  fixtures            TournamentFixture[]
  certificates        Certificate[]
  sponsorshipRequests SponsorshipRequest[]

  @@index([slug])
  @@index([sportId])
  @@index([organizerId])
  @@index([status])
  @@index([startDate])
  @@index([city, state])
}

model TournamentRegistration {
  id              String                      @id @default(uuid())
  tournamentId    String
  participantId   String
  participantType RegistrationParticipantType
  status          RegistrationStatus          @default(PENDING)
  registeredAt    DateTime                    @default(now())
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, participantId])
  @@index([tournamentId])
  @@index([participantId])
  @@index([status])
}

model TournamentFixture {
  id             String        @id @default(uuid())
  tournamentId   String
  round          Int
  matchNumber    Int
  participant1Id String
  participant2Id String
  winnerId       String?
  score1         Int?
  score2         Int?
  scheduledAt    DateTime?
  venue          String?
  status         FixtureStatus @default(SCHEDULED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([round, matchNumber])
  @@index([status])
}

model Achievement {
  id          String    @id @default(uuid())
  athleteId   String
  title       String
  description String?
  date        DateTime?
  category    String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([category])
}

model Certificate {
  id           String          @id @default(uuid())
  title        String
  description  String?
  type         CertificateType
  recipientId  String
  issuerId     String
  tournamentId String?
  athleteId    String?
  qrCode       String?
  pdfUrl       String?
  issuedAt     DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tournament Tournament?     @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  athlete    AthleteProfile? @relation("AthleteCertificates", fields: [athleteId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([issuerId])
  @@index([tournamentId])
  @@index([athleteId])
  @@index([type])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model PerformanceRecord {
  id        String   @id @default(uuid())
  athleteId String
  sportId   String
  date      DateTime
  metric    String
  value     Float
  unit      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sport   Sport          @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([sportId])
  @@index([date])
}

model SponsorshipRequest {
  id           String            @id @default(uuid())
  sponsorId    String
  athleteId    String?
  schoolId     String?
  tournamentId String?
  type         SponsorshipType
  amount       Float
  message      String?
  status       SponsorshipStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  sponsor    SponsorProfile  @relation("SponsorSponsorships", fields: [sponsorId], references: [id], onDelete: Cascade)
  athlete    AthleteProfile? @relation("AthleteSponsorships", fields: [athleteId], references: [id], onDelete: SetNull)
  school     SchoolProfile?  @relation("SchoolSponsorships", fields: [schoolId], references: [id], onDelete: SetNull)
  tournament Tournament?     @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([sponsorId])
  @@index([athleteId])
  @@index([schoolId])
  @@index([tournamentId])
  @@index([status])
}

model Gallery {
  id          String      @id @default(uuid())
  userId      String
  title       String
  description String?
  imageUrl    String
  type        GalleryType @default(IMAGE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model ContactRequest {
  id        String               @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactRequestStatus @default(PENDING)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AthleteSport {
  id           String   @id @default(uuid())
  athleteId    String
  sportId      String
  level        String?
  achievements String?
  createdAt    DateTime @default(now())

  athlete AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sport   Sport          @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([athleteId, sportId])
  @@index([athleteId])
  @@index([sportId])
}
